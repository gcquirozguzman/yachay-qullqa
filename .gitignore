# Entorno y cache de Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Claves y secretos
.env
.env.*
*.key
*credentials*.json
*service-account*.json

# Contenido pesado o privado de cada curso
# - clases/: videos originales y chats de Zoom (nombres y correos de companeros)
# - materiales/, capturas/: descargas y pantallazos
# - .trabajo/: respuestas intermedias de Gemini y tramos de video
cursos/*/clases/
cursos/*/materiales/
cursos/*/capturas/
cursos/*/.trabajo/
*.mp4
*.mov
*.mkv
*.webm
*.avi
